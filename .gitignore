## .gitignore for .NET / Visual Studio projects (e.g. Norton Tech Test)

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# .NET Core / SDK
project.lock.json
project.fragment.lock.json
artifacts/
*.nuget.props
*.nuget.targets

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

# Build outputs / packages
*.dll
*.exe
*.pdb
*.cache
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.assets.json

# MSBuild Binary and Structured Log
*.binlog

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/
*.code-workspace

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info

# Publish output
**/[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# Azure / Cloud config (often contains secrets)
*.PublishSettings
PublishScripts/
csx/
*.appxupload
*.appxsym

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Others
*.DotSettings.user
*.rsuser
*.sap
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegen.cs

# Local secrets / environment
appsettings.*.local.json
*.env
.env.local
secrets.json

# macOS / OS junk
.DS_Store
Thumbs.db